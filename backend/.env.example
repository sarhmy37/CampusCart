# PostgreSQL connection
# Locally, something like: postgresql://postgres:yourpassword@localhost:5432/campuscart
# On Render, you'll get this from your PostgreSQL instance's "Internal Connection String"
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/campuscart

# Set to "true" only if your DB requires SSL (Render's managed Postgres does)
DB_SSL=false

# Any long random string — used to sign login tokens
JWT_SECRET=replace_this_with_a_long_random_string

# Comma-separated list of frontend URLs allowed to call this API
# e.g. http://localhost:5173,https://your-frontend.onrender.com
CORS_ORIGIN=http://localhost:5173

PORT=5000
